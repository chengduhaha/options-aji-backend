{
  "slug": "unusual",
  "title_en": "Understanding the Unusual Activity Board: How Volume Reveals Smart Money",
  "excerpt_en": "Vol/OI ratio flags fresh positioning—today's volume exceeding stored open interest means new money, not just rotation.",
  "body_en": "<style>\n  .aji-guide{\n    --bg:#f5f2f0; --ink:#151617; --gold:#c9a227;\n    --card:#fffdfb; --line:#e7e1d8; --muted:#6f6a63; --soft:#c9c2b6;\n    background:var(--bg); color:var(--ink);\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;\n    line-height:1.75; font-size:16px; padding:4px;\n  }\n  .aji-guide h2{font-size:22px;margin:0 0 10px;font-weight:700;letter-spacing:.2px}\n  .aji-guide h3{font-size:18px;margin:26px 0 8px;font-weight:700}\n  .aji-guide p{margin:10px 0}\n  .aji-guide .lead{font-size:17px}\n  .aji-guide .accent{color:var(--gold);font-weight:700}\n  .aji-guide .chart-card{\n    background:var(--card);border:1px solid var(--line);border-radius:14px;\n    padding:20px 22px;margin:22px 0;box-shadow:0 1px 3px rgba(21,22,23,.05);\n  }\n  .aji-guide .chart-note{font-size:13.5px;color:var(--muted);margin:6px 0 14px}\n  .aji-guide canvas{max-width:100%}\n  .aji-guide .analogy{\n    border-left:4px solid var(--gold);background:rgba(201,162,39,.07);\n    padding:12px 16px;border-radius:0 10px 10px 0;margin:16px 0;\n  }\n  .aji-guide .data-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:14.5px;overflow:hidden;border-radius:10px}\n  .aji-guide .data-table th{\n    background:var(--ink);color:#f5f2f0;text-align:left;padding:11px 14px;font-weight:600;\n  }\n  .aji-guide .data-table td{padding:11px 14px;border-bottom:1px solid var(--line);vertical-align:top}\n  .aji-guide .data-table tr:nth-child(even) td{background:rgba(201,162,39,.035)}\n  .aji-guide .data-table .col{font-weight:700;color:var(--ink);white-space:nowrap}\n  .aji-guide .tag{display:inline-block;font-size:12px;font-weight:700;padding:2px 8px;border-radius:20px}\n  .aji-guide .tag-core{background:var(--gold);color:#fff}\n  .aji-guide .tag-base{background:var(--soft);color:var(--ink)}\n  /* 自测器 */\n  .aji-guide .calc{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;margin:8px 0 4px}\n  .aji-guide .calc label{display:flex;flex-direction:column;font-size:13px;color:var(--muted);gap:5px}\n  .aji-guide .calc input{\n    width:130px;padding:9px 11px;border:1px solid var(--line);border-radius:8px;\n    font-size:15px;background:#fff;color:var(--ink);\n  }\n  .aji-guide .calc input:focus{outline:2px solid var(--gold);border-color:var(--gold)}\n  .aji-guide .verdict{margin-top:16px;padding:14px 16px;border-radius:10px;font-size:15px;font-weight:600}\n  .aji-guide .ratio-num{font-size:30px;font-weight:800;color:var(--gold);display:block;line-height:1.1}\n  .aji-guide .disclaimer{font-size:12.5px;color:var(--muted);margin-top:26px;padding-top:14px;border-top:1px solid var(--line)}\n  .aji-guide .cta{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#fff;text-decoration:none;font-weight:700;padding:11px 20px;border-radius:10px;font-size:15px;box-shadow:0 2px 6px rgba(201,162,39,.3);transition:background .15s}\n  .aji-guide .cta:hover{background:#b8911f}\n  .aji-guide .cta-row{margin:16px 0 4px}\n  .aji-guide .cta-bottom{background:rgba(201,162,39,.08);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:24px 0 8px;text-align:center}\n  .aji-guide .cta-bottom p{margin:0 0 10px;font-weight:700}\n</style>\n\n<div class=\"aji-guide\">\n  <h2>Understanding the Unusual Activity Board: How Volume Reveals Smart Money</h2>\n  <p class=\"lead\">One question: <span class=\"accent\">Is big money quietly opening new positions today?</span> The signal is simple—<b>Volume ÷ Open Interest (Vol/OI)</b>. Higher ratio = fresh flow, not just old hands swapping.</p>\n  <div class=\"cta-row\"><a class=\"cta\" href=\"https://www.options-aji.com/options/unusual\" target=\"_blank\" rel=\"noopener\">📊 Open live Unusual Activity board →</a></div>\n  <h3>1. Open Interest vs Volume</h3>\n  <div class=\"analogy\"><p style=\"margin:4px 0\"><b>Think of a contract like a venue 🕺</b></p>\n  <p style=\"margin:4px 0\">• <b>OI</b> = people still inside at last close (inventory).</p>\n  <p style=\"margin:4px 0\">• <b>Volume</b> = total entries/exits today (activity).</p>\n  <p style=\"margin:8px 0 4px\">If today's traffic exceeds everyone inside (Vol/OI &gt; 1), <span class=\"accent\">new faces</span> are building—unusual activity.</p></div>\n  <div class=\"chart-card\"><h2 style=\"font-size:18px\">Volume vs OI: Who Got Hot Today?</h2><p class=\"chart-note\">Gold bars exceed gray OI on select names—that's the signal. Rendered with Chart.js via jsDelivr CDN only.</p><canvas id=\"ajiVolOiBar\" width=\"640\" height=\"300\" aria-label=\"Volume vs OI\"></canvas></div>\n  <h3>2. Why Vol/OI &gt; 1?</h3>\n  <p><b>1.0 is the watershed.</b> Above (gold): today's volume exceeds stored OI—new builds. Below (gray): mostly rotation.</p>\n  <div class=\"chart-card\"><h2 style=\"font-size:18px\">Vol/OI Ranking</h2><p class=\"chart-note\">Dashed = 1.0 threshold. Gold above = unusual.</p><canvas id=\"ajiRatioBar\" width=\"640\" height=\"300\" aria-label=\"Vol/OI ranking\"></canvas></div>\n  <div class=\"chart-card\"><h2 style=\"font-size:18px\">🧮 Is This Contract Unusual?</h2><p class=\"chart-note\">Local calculator—no network.</p>\n  <div class=\"calc\"><label>Volume Vol<input id=\"ajiVol\" type=\"number\" min=\"0\" step=\"100\" value=\"48000\" inputmode=\"numeric\"></label>\n  <label>OI (prior day)<input id=\"ajiOi\" type=\"number\" min=\"0\" step=\"100\" value=\"12000\" inputmode=\"numeric\"></label></div>\n  <div class=\"verdict\" id=\"ajiVerdict\"></div></div>\n  <h3>3. Column Guide</h3>\n  <table class=\"data-table\"><thead><tr><th>Column</th><th>Meaning</th><th>How to use</th></tr></thead><tbody>\n  <tr><td class=\"col\">#</td><td>Rank by Vol/OI.</td><td>Higher = fresher flow.</td></tr>\n  <tr><td class=\"col\">Contract</td><td>Symbol, expiry, strike, Call/Put.</td><td>Near-month call spikes often bullish-leaning.</td></tr>\n  <tr><td class=\"col\">Vol/OI <span class=\"tag tag-core\">Core</span></td><td>Volume ÷ OI.</td><td>&gt;1 watch; &gt;3–5 dig deeper.</td></tr>\n  <tr><td class=\"col\">Volume</td><td>Contracts today.</td><td>Need absolute size too.</td></tr>\n  <tr><td class=\"col\">OI</td><td>Prior-day open interest.</td><td>Low OI inflates ratio—check turnover.</td></tr>\n  <tr><td class=\"col\">Turnover</td><td>Premium × qty × 100.</td><td><span class=\"accent\">Weight the signal</span> in dollars.</td></tr>\n  <tr><td class=\"col\">IV <span class=\"tag tag-base\">Aux</span></td><td>Implied vol.</td><td>IV spike → event odds.</td></tr>\n  <tr><td class=\"col\">Chg <span class=\"tag tag-base\">Aux</span></td><td>Contract price change.</td><td>Price up + volume = clearer lean.</td></tr>\n  </tbody></table>\n  <h3>4. Three Pitfalls</h3>\n  <p><b>1. Unusual ≠ direction.</b> Could be hedges or spread legs.<br><b>2. OI is yesterday's number</b>—early session ratios skew high.<br><b>3. Tiny OI amplifies ratio</b>—always weigh with turnover.</p>\n  <div class=\"cta-bottom\"><p>Ready to explore? See today's live data 👇</p><a class=\"cta\" href=\"https://www.options-aji.com/options/unusual\" target=\"_blank\" rel=\"noopener\">📊 Open live Unusual Activity board →</a></div><p class=\"disclaimer\">Data may be delayed ~15 minutes. For research only—not investment advice. Options trading involves substantial risk of loss. © OptionsAji</p>\n\n<!-- Chart.js：仅 jsDelivr -->\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<script>\n(function () {\n  if (typeof Chart === 'undefined') return;\n\n  var GOLD = '#c9a227';\n  var GOLD_SOFT = 'rgba(201,162,39,.85)';\n  var GRAY = '#c9c2b6';\n  var INK = '#151617';\n\n  var labels = ['A TSLA C', 'B NVDA C', 'C AAPL P', 'D SPY P', 'E AMD C'];\n  var vol = [48000, 30000, 40000, 25000, 44000];\n  var oi  = [12000, 52000, 15000, 60000, 10000];\n\n  // 图1：成交量 vs 持仓量（分组柱）\n  var c1 = document.getElementById('ajiVolOiBar');\n  if (c1) {\n    new Chart(c1, {\n      type: 'bar',\n      data: {\n        labels: labels,\n        datasets: [\n          { label: 'Volume Vol', data: vol, backgroundColor: GOLD_SOFT, borderRadius: 4 },\n          { label: 'Open Interest OI', data: oi, backgroundColor: GRAY, borderRadius: 4 }\n        ]\n      },\n      options: {\n        responsive: true,\n        plugins: {\n          legend: { labels: { color: INK, font: { size: 13 } } },\n          tooltip: { callbacks: { label: function (i) { return i.dataset.label + ': ' + i.parsed.y.toLocaleString() + ' contracts'; } } }\n        },\n        scales: {\n          x: { ticks: { color: INK } , grid: { display: false } },\n          y: { ticks: { color: INK, callback: function (v){ return (v/1000) + 'k'; } }, grid: { color: 'rgba(21,22,23,.06)' } }\n        }\n      }\n    });\n  }\n\n  // 图2：Vol/OI 比值 + 阈值线（柱 + 折线）\n  var ratios = vol.map(function (v, i) { return +(v / oi[i]).toFixed(2); });\n  var barColors = ratios.map(function (r) { return r > 1 ? GOLD : GRAY; });\n  var c2 = document.getElementById('ajiRatioBar');\n  if (c2) {\n    new Chart(c2, {\n      data: {\n        labels: labels,\n        datasets: [\n          { type: 'bar', label: 'Vol/OI ratio', data: ratios, backgroundColor: barColors, borderRadius: 4, order: 2 },\n          { type: 'line', label: 'Threshold = 1.0', data: labels.map(function(){ return 1; }),\n            borderColor: INK, borderDash: [6,5], borderWidth: 1.5, pointRadius: 0, order: 1 }\n        ]\n      },\n      options: {\n        responsive: true,\n        plugins: {\n          legend: { labels: { color: INK, font: { size: 13 } } },\n          tooltip: { callbacks: { label: function (i) {\n            return i.dataset.type === 'line' ? 'Threshold 1.0' : ('Vol/OI = ' + i.parsed.y + (i.parsed.y > 1 ? ' (unusual)' : ' (normal)'));\n          } } }\n        },\n        scales: {\n          x: { ticks: { color: INK }, grid: { display: false } },\n          y: { beginAtZero: true, ticks: { color: INK }, grid: { color: 'rgba(21,22,23,.06)' } }\n        }\n      }\n    });\n  }\n\n  // 自测器\n  var volIn = document.getElementById('ajiVol');\n  var oiIn = document.getElementById('ajiOi');\n  var out = document.getElementById('ajiVerdict');\n  function render() {\n    if (!out) return;\n    var v = parseFloat(volIn.value), o = parseFloat(oiIn.value);\n    if (!(v >= 0) || !(o > 0)) {\n      out.style.background = 'rgba(21,22,23,.05)';\n      out.style.color = '#6f6a63';\n      out.innerHTML = 'Enter valid volume and OI (OI must be &gt; 0).';\n      return;\n    }\n    var r = v / o;\n    var rTxt = '<span class=\"ratio-num\">' + r.toFixed(2) + '</span>';\n    var msg, bg, col;\n    if (r >= 3) { msg = '⚡ Strong unusual: volume is ' + r.toFixed(1) + '× stored OI—likely new builds; investigate.'; bg = 'rgba(201,162,39,.16)'; col = '#151617'; }\n    else if (r >= 1) { msg = '⚡ Unusual: volume exceeds OI—possible new money. Weigh with turnover.'; bg = 'rgba(201,162,39,.12)'; col = '#151617'; }\n    else if (r >= 0.5) { msg = '🔸 Active but typical rotation—not unusual yet.'; bg = 'rgba(21,22,23,.05)'; col = '#6f6a63'; }\n    else { msg = '⚪ Normal: existing positions rotating.'; bg = 'rgba(21,22,23,.05)'; col = '#6f6a63'; }\n    out.style.background = bg; out.style.color = col;\n    out.innerHTML = 'Vol/OI ' + rTxt + msg;\n  }\n  if (volIn && oiIn) {\n    volIn.addEventListener('input', render);\n    oiIn.addEventListener('input', render);\n    render();\n  }\n})();\n</script>"
}
