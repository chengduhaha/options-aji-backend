{
  "slug": "premium",
  "title_en": "Understanding the Premium Turnover Board: Where Real Dollars Flow",
  "excerpt_en": "Ranked by notional premium—not contract count. Dollar flow often reveals institutional footprints better than volume alone.",
  "body_en": "<style>\n  .aji-guide{\n    --bg:#f5f2f0; --ink:#151617; --gold:#c9a227;\n    --card:#fffdfb; --line:#e7e1d8; --muted:#6f6a63; --soft:#c9c2b6;\n    background:var(--bg); color:var(--ink);\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;\n    line-height:1.75; font-size:16px; padding:4px;\n  }\n  .aji-guide h2{font-size:22px;margin:0 0 10px;font-weight:700;letter-spacing:.2px}\n  .aji-guide h3{font-size:18px;margin:26px 0 8px;font-weight:700}\n  .aji-guide p{margin:10px 0}\n  .aji-guide .lead{font-size:17px}\n  .aji-guide .accent{color:var(--gold);font-weight:700}\n  .aji-guide .chart-card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin:22px 0;box-shadow:0 1px 3px rgba(21,22,23,.05)}\n  .aji-guide .chart-note{font-size:13.5px;color:var(--muted);margin:6px 0 14px}\n  .aji-guide canvas{max-width:100%}\n  .aji-guide .analogy{border-left:4px solid var(--gold);background:rgba(201,162,39,.07);padding:12px 16px;border-radius:0 10px 10px 0;margin:16px 0}\n  .aji-guide .data-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:14.5px;overflow:hidden;border-radius:10px}\n  .aji-guide .data-table th{background:var(--ink);color:#f5f2f0;text-align:left;padding:11px 14px;font-weight:600}\n  .aji-guide .data-table td{padding:11px 14px;border-bottom:1px solid var(--line);vertical-align:top}\n  .aji-guide .data-table tr:nth-child(even) td{background:rgba(201,162,39,.035)}\n  .aji-guide .data-table .col{font-weight:700;color:var(--ink);white-space:nowrap}\n  .aji-guide .tag{display:inline-block;font-size:12px;font-weight:700;padding:2px 8px;border-radius:20px}\n  .aji-guide .tag-core{background:var(--gold);color:#fff}\n  .aji-guide .tag-base{background:var(--soft);color:var(--ink)}\n  .aji-guide .calc{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;margin:8px 0 4px}\n  .aji-guide .calc label{display:flex;flex-direction:column;font-size:13px;color:var(--muted);gap:5px}\n  .aji-guide .calc input{width:150px;padding:9px 11px;border:1px solid var(--line);border-radius:8px;font-size:15px;background:#fff;color:var(--ink)}\n  .aji-guide .calc input:focus{outline:2px solid var(--gold);border-color:var(--gold)}\n  .aji-guide .verdict{margin-top:16px;padding:14px 16px;border-radius:10px;font-size:15px;font-weight:600;background:rgba(201,162,39,.12)}\n  .aji-guide .big-num{font-size:30px;font-weight:800;color:var(--gold);display:block;line-height:1.15}\n  .aji-guide .disclaimer{font-size:12.5px;color:var(--muted);margin-top:26px;padding-top:14px;border-top:1px solid var(--line)}\n  .aji-guide .cta{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#fff;text-decoration:none;font-weight:700;padding:11px 20px;border-radius:10px;font-size:15px;box-shadow:0 2px 6px rgba(201,162,39,.3);transition:background .15s}\n  .aji-guide .cta:hover{background:#b8911f}\n  .aji-guide .cta-row{margin:16px 0 4px}\n  .aji-guide .cta-bottom{background:rgba(201,162,39,.08);border:1px solid var(--line);border-radius:12px;padding:18px 20px;margin:24px 0 8px;text-align:center}\n  .aji-guide .cta-bottom p{margin:0 0 10px;font-weight:700}\n</style>\n\n<div class=\"aji-guide\">\n  <h2>Understanding the Premium Turnover Board: Where Real Dollars Flow</h2>\n  <p class=\"lead\">Volume counts contracts; this board counts <span class=\"accent\">dollars spent</span>. Sorted by <b>notional premium turnover</b>, it shows where big money landed today—often a sharper signal than raw volume.</p>\n  <div class=\"cta-row\"><a class=\"cta\" href=\"https://www.options-aji.com/options/turnover\" target=\"_blank\" rel=\"noopener\">📊 Open live Premium Turnover board →</a></div>\n  <h3>1. Why Dollars Beat Contract Count</h3>\n  <div class=\"analogy\"><p style=\"margin:4px 0\"><b>Turnover ≈ avg premium × contracts × 100</b> (100 shares per contract).</p>\n  <p style=\"margin:4px 0\">• A: 1,000 contracts at <b>$0.50</b> → <b>$50k</b> (busy, light dollars).</p>\n  <p style=\"margin:4px 0\">• B: 100 contracts at <b>$20</b> → <b>$200k</b> (quiet count, heavy money).</p>\n  <p style=\"margin:8px 0 4px\">Volume ranks A first; turnover ranks B first. <span class=\"accent\">This board filters volume inflation.</span></p></div>\n  <div class=\"chart-card\"><h2 style=\"font-size:18px\">Contracts vs Dollars: Rankings Reshuffle (example)</h2><p class=\"chart-note\">Gray = volume (left); gold = turnover $M (right). AAPL leads volume but trails dollars. Rendered with Chart.js via jsDelivr CDN only.</p><canvas id=\"ajiPremDual\" width=\"640\" height=\"300\" aria-label=\"Volume vs turnover\"></canvas></div>\n  <h3>2. Calculator: How Much Money Moved?</h3>\n  <div class=\"chart-card\"><h2 style=\"font-size:18px\">🧮 Turnover Calculator</h2><p class=\"chart-note\">See how price per share scales dollars. Local only.</p>\n  <div class=\"calc\"><label>Avg premium ($/share)<input id=\"ajiPrice\" type=\"number\" min=\"0\" step=\"0.05\" value=\"12.50\" inputmode=\"decimal\"></label>\n  <label>Contracts<input id=\"ajiQty\" type=\"number\" min=\"0\" step=\"100\" value=\"8000\" inputmode=\"numeric\"></label></div>\n  <div class=\"verdict\" id=\"ajiPremOut\"></div></div>\n  <h3>3. Column Guide</h3>\n  <table class=\"data-table\"><thead><tr><th>Column</th><th>Meaning</th><th>How to use</th></tr></thead><tbody>\n  <tr><td class=\"col\">#</td><td>Rank by turnover.</td><td>More dollars today.</td></tr>\n  <tr><td class=\"col\">Contract</td><td>Symbol, expiry, strike, side.</td><td>Near vs far; calls vs puts.</td></tr>\n  <tr><td class=\"col\">Turnover <span class=\"tag tag-core\">Core</span></td><td>Notional = avg × qty × 100.</td><td><span class=\"accent\">Direct size signal</span>.</td></tr>\n  <tr><td class=\"col\">Volume</td><td>Contracts traded.</td><td>Vs turnover: retail pile vs block.</td></tr>\n  <tr><td class=\"col\">Avg Premium</td><td>Mean fill price.</td><td>Higher price → more dollars per lot.</td></tr>\n  <tr><td class=\"col\">OI</td><td>Open interest.</td><td>Building or rolling?</td></tr>\n  <tr><td class=\"col\">IV <span class=\"tag tag-base\">Aux</span></td><td>Implied vol.</td><td>Big $ + rising IV → events.</td></tr>\n  <tr><td class=\"col\">Chg <span class=\"tag tag-base\">Aux</span></td><td>Contract price change.</td><td>Money in + price up = clearer lean.</td></tr>\n  </tbody></table>\n  <h3>4. Two Reminders</h3>\n  <p><b>1. Big turnover ≠ clear direction.</b> Could be hedges or spreads.<br><b>2. Deep ITM contracts inflate dollars</b>—check if it's new speculation or roll.</p>\n  <div class=\"cta-bottom\"><p>Ready to explore? See today's live data 👇</p><a class=\"cta\" href=\"https://www.options-aji.com/options/turnover\" target=\"_blank\" rel=\"noopener\">📊 Open live Premium Turnover board →</a></div><p class=\"disclaimer\">Data may be delayed ~15 minutes. For research only—not investment advice. Options trading involves substantial risk of loss. © OptionsAji</p>\n\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js\"></script>\n<script>\n(function(){\n  if (typeof Chart === 'undefined') return;\n  var GOLD='#c9a227', GOLD_SOFT='rgba(201,162,39,.85)', GRAY='#c9c2b6', INK='#151617';\n\n  var labels=['NVDA C','TSLA C','SPY P','AMD C','AAPL C'];\n  var qty=[8000,9000,15000,6000,60000];          // 张\n  var notional=[10.0,7.4,4.7,3.4,2.7];             // 百万刀\n  var c1=document.getElementById('ajiPremDual');\n  if(c1){ new Chart(c1,{type:'bar',data:{labels:labels,datasets:[\n      {label:'Volume (contracts)',data:qty,backgroundColor:GRAY,borderRadius:4,yAxisID:'y'},\n      {label:'Turnover ($M)',data:notional,backgroundColor:GOLD_SOFT,borderRadius:4,yAxisID:'y1'}]},\n    options:{responsive:true,plugins:{legend:{labels:{color:INK,font:{size:13}}},\n      tooltip:{callbacks:{label:function(i){return i.dataset.yAxisID==='y1'?('Turnover $'+i.parsed.y+'M'):(i.parsed.y.toLocaleString()+' contracts');}}}},\n      scales:{x:{ticks:{color:INK},grid:{display:false}},\n        y:{position:'left',title:{display:true,text:'Contracts',color:INK},ticks:{color:INK,callback:function(v){return (v/1000)+'k';}},grid:{color:'rgba(21,22,23,.06)'}},\n        y1:{position:'right',title:{display:true,text:'Turnover $M',color:GOLD},ticks:{color:GOLD},grid:{drawOnChartArea:false}}}}}); }\n\n  var priceIn=document.getElementById('ajiPrice');\n  var qtyIn=document.getElementById('ajiQty');\n  var out=document.getElementById('ajiPremOut');\n  function fmt(n){ if(n>=1e6) return '$'+(n/1e6).toFixed(2)+'M'; if(n>=1e3) return '$'+(n/1e3).toFixed(1)+'k'; return '$'+n.toFixed(0); }\n  function render(){\n    if(!out) return;\n    var p=parseFloat(priceIn.value), q=parseFloat(qtyIn.value);\n    if(!(p>=0)||!(q>=0)){ out.style.background='rgba(21,22,23,.05)'; out.style.color='#6f6a63'; out.innerHTML='Enter valid avg price and contract count.'; return; }\n    var amt=p*q*100;\n    out.style.background='rgba(201,162,39,.12)'; out.style.color='#151617';\n    out.innerHTML='本次成交额 <span class=\"big-num\">'+fmt(amt)+'</span>= 均价 $'+p+' × '+q.toLocaleString()+' contracts × 100 shares. Double the price, double the dollars—that's why this board tracks money, not count.';\n  }\n  if(priceIn&&qtyIn){ priceIn.addEventListener('input',render); qtyIn.addEventListener('input',render); render(); }\n})();\n</script>"
}
